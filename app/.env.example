# --- Controller ---------------------------------------------------------
# IP address of your PoolControl .NET (see controller menu: service > network)
OSF_HOST=http://192.168.1.50
# User PIN of the controller (4 digits) — required to send commands
OSF_PIN=
# Polling interval in milliseconds
POLL_MS=10000

# --- Web UI ---------------------------------------------------------------
# Optional basic-auth password (user: pool). Strongly recommended if reachable by others.
APP_PASSWORD=

# --- MQTT / Home Assistant (leave MQTT_URL empty to disable) --------------
MQTT_URL=
MQTT_USER=
MQTT_PASS=
MQTT_PREFIX=poolcontrol
MQTT_DEVICE_NAME=Pool
MQTT_OBJECT_PREFIX=pool
HA_DISCOVERY_PREFIX=homeassistant
# The light (AUX) is often interlocked with the pump: ON starts the pump first
AUX_STARTS_PUMP=true
